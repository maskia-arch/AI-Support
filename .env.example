# ==============================================================================
# Umgebungs-Konfiguration (Coolify & VPS-Betrieb)
# Kopiere diese Datei in deine .env oder trage sie direkt bei Coolify ein.
# ==============================================================================

# Lokale PostgreSQL Datenbank (in Coolify als Service erstellbar)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB_NAME]
# Wenn du PostgreSQL in Coolify erstellst, erhältst du den Connection-String automatisch.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# AI Provider API Keys
# DeepSeek API-Schlüssel (für das Chat-Modell)
DEEPSEEK_API_KEY=your_deepseek_api_key
# Optional: OpenAI API-Schlüssel (für die Erstellung von Embeddings)
OPENAI_API_KEY=your_openai_key_for_embeddings
# Optional: xAI (Grok) API-Schlüssel
XAI_API_KEY=your_xai_api_key

# Telegram Bot Token (für den eSIM Support Bot)
TELEGRAM_BOT_TOKEN=your_support_bot_token

# Admin Dashboard Zugangsdaten (für /admin Login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
# Ein sicherer zufälliger String mit mindestens 32 Zeichen für die JWT-Signierung
JWT_SECRET=some_random_32_character_string

# Web Push Benachrichtigungen (für neue Chats im Dashboard)
# Generierbar via: npm run generate-vapid
VAPID_PUBLIC_KEY=your_web_push_public_key
VAPID_PRIVATE_KEY=your_web_push_private_key

# App Einstellungen
# Die öffentliche URL deines Coolify-Deployments (z. B. https://esim-bot.deindomain.de)
APP_URL=https://your-coolify-domain.com
# Port auf dem die Node.js App läuft (Coolify leitet diesen automatisch weiter)
PORT=3000
